<b:skin><![CDATA[
    :root {
      --primary: #1CABE2;
      --primary-hover: #1796c7;
      --primary-soft: #EAF7FC;
      --surface: #FFFFFF;
      --page: #F8FAFC;
      --text: #0F172A;
      --muted: #64748B;
      --border: #E2E8F0;
      --sidebar: #FFFFFF;
      --sidebar-text: #334155;
      --shadow: 0 8px 30px rgba(15, 23, 42, .06);
    }

    html[data-theme='dark'] {
      --surface: #111827;
      --page: #0B1120;
      --text: #E5E7EB;
      --muted: #94A3B8;
      --border: #263244;
      --sidebar: #0F172A;
      --sidebar-text: #CBD5E1;
      --primary-soft: #12384A;
      --shadow: 0 8px 30px rgba(0, 0, 0, .24);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--page) !important;
      color: var(--text) !important;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    a { color: inherit; }
    .theme-surface { background: var(--surface) !important; }
    .theme-border { border-color: var(--border) !important; }
    .theme-text { color: var(--text) !important; }
    .theme-muted { color: var(--muted) !important; }
    .theme-primary { color: var(--primary) !important; }
    .theme-primary-bg { background: var(--primary) !important; }
    .theme-soft { background: var(--primary-soft) !important; }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 9999px; }
    html[data-theme='dark'] .custom-scrollbar::-webkit-scrollbar-thumb { background: #475569; }

    .sidebar {
      width: 18rem;
      background: var(--sidebar) !important;
      border-color: var(--border) !important;
      color: var(--sidebar-text);
    }
    .sidebar.collapsed { width: 5rem; }
    .sidebar.collapsed .sidebar-label,
    .sidebar.collapsed .sidebar-heading,
    .sidebar.collapsed .sidebar-status { display: none !important; }
    .sidebar.collapsed .sidebar-header-button { justify-content: center; }
    .sidebar.collapsed .sidebar-home { justify-content: center; }
    .sidebar.collapsed .sidebar-toggle { margin-left: auto; margin-right: auto; }
    .sidebar-header { background: var(--surface) !important; border-color: var(--border) !important; }
    .sidebar-home { color: var(--text) !important; background: var(--primary-soft) !important; }
    .sidebar-home:hover { background: #DDF3FB !important; }
    html[data-theme='dark'] .sidebar-home:hover { background: #16445A !important; }
    .sidebar-status-wrap { background: var(--page) !important; border-color: var(--border) !important; }

    .post-card {
      background: var(--surface) !important;
      border: 1px solid var(--border) !important;
      box-shadow: var(--shadow);
    }

    /* --- Post Body Theme Fixes --- */
    .post-body, .post-body p, .post-body span, .post-body li, .post-body td, .post-body th {
      color: var(--text) !important;
    }
    .post-body table {
      background-color: var(--surface) !important;
      border-color: var(--border) !important;
    }
    .post-body th, .post-body td {
      border-color: var(--border) !important;
    }
    /* ----------------------------- */

    .post-title-main { color: var(--text) !important; }
    .post-content { color: var(--muted) !important; }
    .post-content img { max-width: 100%; height: auto; border-radius: .75rem; }
    .post-content a { color: var(--primary); }
    .post-content a:hover { color: var(--primary-hover); }

    .theme-toggle {
      width: 2.5rem; height: 2.5rem; border-radius: .75rem;
      border: 1px solid var(--border); background: var(--surface);
      color: var(--text); cursor: pointer; display: inline-flex;
      align-items: center; justify-content: center; transition: all .2s ease;
    }
    .theme-toggle:hover { color: var(--primary); border-color: var(--primary); background: var(--primary-soft); }

    .mobile-menu-button { display: none; }
    .mobile-overlay { display: none; }
    @media (max-width: 1023px) {
      .sidebar { width: 18rem; transform: translateX(-100%); position: fixed !important; }
      .sidebar.mobile-open { transform: translateX(0); }
      .sidebar.collapsed { width: 18rem; }
      .sidebar.collapsed .sidebar-label,
      .sidebar.collapsed .sidebar-heading,
      .sidebar.collapsed .sidebar-status { display: block !important; }
      .sidebar.collapsed .sidebar-header-button,
      .sidebar.collapsed .sidebar-home { justify-content: flex-start; }
      .mobile-menu-button { display: inline-flex; }
      .mobile-overlay {
        display: block; position: fixed; inset: 0; background: rgba(15,23,42,.38);
        backdrop-filter: blur(2px); z-index: 30; opacity: 0; pointer-events: none; transition: opacity .2s ease;
      }
      .mobile-overlay.visible { opacity: 1; pointer-events: auto; }
    }

    /* Blogger system elements */
    .widget-title, .header-widget { display: none; }
    .blog-pager a, .jump-link a { color: var(--primary); }
    .comments, .author-profile { background: var(--surface); color: var(--text); border-color: var(--border); }
    input, textarea, select { background: var(--surface); color: var(--text); border-color: var(--border); }
  ]]></b:skin>


            dbStatus: 'Booting...',
            activeTab: 'records',
            registryColumns: REGISTRY_COLUMNS,
            eventColumns: EVENT_DISPLAY_COLUMNS,

            registry: [],
            events: [],
            dirSearch: '',
            dirLivingFilter: DEFAULT_DIRECTORY_LIVING,

            showRegisterModal: false,
            showSessionModal: false,

            regForm: { ...BLANK_REG_FORM },
            lookup: { eir_id: '', foolhumaa_form_number: '', beneficiary_national_id: '', status: 'idle', result: null },
            session: { beneficiary: null },
            visitForm: {},
            _lookupTimer: null,

            clientIp: 'Detecting IP...',
            syncStatus: 'synced',
            syncStatusText: 'Cloud mirror up to date',
            get syncIndicatorClass() {
                if (this.syncStatus === 'synced') return 'bg-green-500';
                if (this.syncStatus === 'syncing') return 'bg-amber-500 animate-pulse';
                return 'bg-red-500';
            },

            formatAge(dob) { return formatAgeFromDob(dob); },

            async initEngine() {
                this.fetchClientIp();
                try {
                    const SQL = await initSqlJs({
                        locateFile: f => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${f}`
                    });

                    const saved = localStorage.getItem('shah_eir_db');
                    let loaded = false;
                    if (saved) {
                        try {
                            this.db = new SQL.Database(Uint8Array.from(JSON.parse(saved)));
                            loaded = true;
                        } catch (e) { console.warn('Corrupt DB, starting fresh:', e); }
                    }
                    if (!loaded) this.db = new SQL.Database();

                    this.createTables();
                    this.visitForm = this.blankVisitForm();
                    this.refreshAll();

                    await this.hydrateFromCloud();
                } catch (err) {
                    console.error(err);
                    this.dbStatus = 'DB init error: ' + err.message;
                }
            },

            async fetchClientIp() {
                try {
                    const res = await fetch('https://api.ipify.org?format=json');
                    const data = await res.json();
                    this.clientIp = data.ip;
                } catch (e) {
                    this.clientIp = 'Offline Mode';
                }
            },

            createTables() {
                this.db.run(`
                    CREATE TABLE IF NOT EXISTS vaccination_registry (
                        id TEXT PRIMARY KEY,
                        currently_living TEXT, eir_id TEXT UNIQUE, beneficiary_name TEXT NOT NULL,
                        foolhumaa_form_number TEXT, beneficiary_national_id TEXT,
                        dob TEXT, sex TEXT, atoll_island_residence TEXT, current_address TEXT,
                        mother_name TEXT, mother_national_id TEXT, primary_contact TEXT,
                        caregiver_name TEXT, caregiver_id TEXT, caregiver_contact TEXT, country TEXT,
                        gestational_age_weeks INTEGER, birth_weight REAL, delivery_mode TEXT,
                        number_delivered INTEGER, birth_facility TEXT, HepB_Within24h TEXT, remarks TEXT,
                        created_at TEXT DEFAULT (datetime('now'))
                    );
                `);
                this.db.run(`
                    CREATE TABLE IF NOT EXISTS vaccination_events (
                        event_id TEXT PRIMARY KEY,
                        visit_date TEXT, currently_living TEXT, vaccine_centre TEXT,
                        eir_id TEXT, foolhumaa_form_number TEXT, beneficiary_national_id TEXT,
                        beneficiary_name TEXT, dob TEXT, age_at_visit TEXT, sex TEXT,
                        vaccine_name1 TEXT, vaccine_type1 TEXT,
                        vaccine_name2 TEXT, vaccine_type2 TEXT,
                        vaccine_name3 TEXT, vaccine_type3 TEXT,
                        vaccine_name4 TEXT, vaccine_type4 TEXT,
                        vaccine_name5 TEXT, vaccine_type5 TEXT,
                        vaccine_name6 TEXT, vaccine_type6 TEXT,
                        dose_count INTEGER DEFAULT 0,
                        created_at TEXT DEFAULT (datetime('now'))
                    );
                `);
                try {
                    this.db.run(`ALTER TABLE vaccination_events ADD COLUMN age_at_visit TEXT;`);
                } catch (e) {}

                this.db.run(`CREATE INDEX IF NOT EXISTS idx_events_eir ON vaccination_events(eir_id);`);
                this.db.run(`CREATE INDEX IF NOT EXISTS idx_events_date ON vaccination_events(visit_date);`);
                this.db.run(`CREATE INDEX IF NOT EXISTS idx_reg_living ON vaccination_registry(currently_living);`);
                this.persist();
            },

            refreshAll() {
                this.loadRegistry();
                this.loadEvents();
                this.refreshStatus();
            },
            loadRegistry() {
                this.registry = this.queryAll(`SELECT * FROM vaccination_registry ORDER BY created_at DESC;`);
            },
            loadEvents() {
                this.events = this.queryAll(`SELECT * FROM vaccination_events ORDER BY visit_date DESC, created_at DESC;`);
            },
            queryAll(sql, params = []) {
                const out = [];
                try {
                    const stmt = this.db.prepare(sql);
                    stmt.bind(params);
                    while (stmt.step()) out.push(stmt.getAsObject());
                    stmt.free();
                } catch (e) { console.error(e); }
                return out;
            },
            refreshStatus() {
                this.dbStatus = `DB ready · ${this.registry.length} registry · ${this.events.length} events`;
            },
            persist() {
                try {
                    const bytes = this.db.export();
                    localStorage.setItem('shah_eir_db', JSON.stringify(Array.from(bytes)));
                    this.backupToCloud();
                } catch (e) {
                    console.error('Persist failed:', e);
                    Swal.fire('Storage Full', 'Could not save — localStorage quota exceeded.', 'error');
                }
            },
            generateId() {
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
                    const r = Math.random() * 16 | 0;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            },

            async hydrateFromCloud() {
                try {
                    this.syncStatus = 'syncing';
                    this.syncStatusText = 'Pulling data from Cloud Mirror...';
                    const res = await fetch(WEB_APP_URL);
                    const data = await res.json();
                    
                    if (data.status === 'success') {
                        const cloudHasRegistry = data.registry && data.registry.length > 0;
                        const cloudHasEvents = data.events && data.events.length > 0;

                        if (cloudHasRegistry) {
                            this.db.run("DELETE FROM vaccination_registry;");
                            for (const r of data.registry) {
                                const keys = Object.keys(r).filter(k => REGISTRY_COLUMNS.includes(k) || k === 'id');
                                const vals = keys.map(k => r[k] !== undefined ? r[k] : null);
                                this.db.run(`INSERT OR REPLACE INTO vaccination_registry (${keys.join(',')}) VALUES (${keys.map(()=>'?').join(',')});`, vals);
                            }
                        }

                        if (cloudHasEvents) {
                            this.db.run("DELETE FROM vaccination_events;");
                            for (const ev of data.events) {
                                const keys = Object.keys(ev).filter(k => EVENT_DISPLAY_COLUMNS.includes(k) || k === 'event_id');
                                const vals = keys.map(k => ev[k] !== undefined ? ev[k] : null);
                                this.db.run(`INSERT OR REPLACE INTO vaccination_events (${keys.join(',')}) VALUES (${keys.map(()=>'?').join(',')});`, vals);
                            }
                        }

                        this.refreshAll();
                        this.syncStatus = 'synced';
                        this.syncStatusText = 'Hydrated & Synced with Cloud Mirror';
                    }
                } catch (e) {
                    this.syncStatus = 'offline';
                    this.syncStatusText = 'Offline mode';
                }
            },

            async backupToCloud() {
                try {
                    this.syncStatus = 'syncing';
                    this.syncStatusText = 'Pushing backup to Cloud Sheet...';
                    
                    await fetch(WEB_APP_URL, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ type: 'registry', rows: this.registry })
                    });

                    await fetch(WEB_APP_URL, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ type: 'events', rows: this.events })
                    });

                    this.syncStatus = 'synced';
                    this.syncStatusText = 'Cloud mirror up to date';
                } catch (e) {
                    this.syncStatus = 'offline';
                    this.syncStatusText = 'Sync failed (Offline)';
                }
            },

            async manualCloudSync() {
                Swal.fire({ title: 'Syncing...', text: 'Fetching latest records from Google Sheet mirror.', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                await this.hydrateFromCloud();
                await this.backupToCloud();
                Swal.fire({ title: 'Sync Complete!', icon: 'success', timer: 1200, showConfirmButton: false });
            },

            openRegisterModal(prefill = null) {
                this.regForm = { ...BLANK_REG_FORM, ...(prefill || {}) };
                this.showRegisterModal = true;
            },
            closeRegisterModal() { this.showRegisterModal = false; },
            submitRegister() {
                try {
                    const rec = {};
                    for (const col of REGISTRY_COLUMNS) {
                        const v = this.regForm[col];
                        if (v !== undefined && v !== null && v !== '') rec[col] = v;
                    }
                    if (!rec.beneficiary_name || !rec.eir_id) {
                        Swal.fire('Missing fields', 'Beneficiary Name and EIR ID are required.', 'warning');
                        return;
                    }
                    rec.dob = excelDateToISO(rec.dob);
                    if (rec.gestational_age_weeks) rec.gestational_age_weeks = parseInt(rec.gestational_age_weeks, 10) || null;
                    if (rec.birth_weight) rec.birth_weight = parseFloat(rec.birth_weight) || null;
                    if (rec.number_delivered) rec.number_delivered = parseInt(rec.number_delivered, 10) || null;

                    const existing = this.queryAll(`SELECT id FROM vaccination_registry WHERE eir_id = ? LIMIT 1;`, [rec.eir_id]);
                    if (existing.length > 0) {
                        rec.id = existing[0].id;
                        const updateCols = Object.keys(rec).filter(k => k !== 'id' && k !== 'eir_id');
                        const setClause = updateCols.map(k => `${k} = ?`).join(', ');
                        const values = updateCols.map(k => rec[k]);
                        values.push(rec.eir_id);
                        this.db.run(`UPDATE vaccination_registry SET ${setClause} WHERE eir_id = ?;`, values);
                    } else {
                        rec.id = this.generateId();
                        const keys = Object.keys(rec);
                        this.db.run(
                            `INSERT INTO vaccination_registry (${keys.join(',')}) VALUES (${keys.map(() => '?').join(',')});`,
                            keys.map(k => rec[k])
                        );
                    }

                    this.persist();
                    this.refreshAll();
                    this.closeRegisterModal();
                    Swal.fire('Saved', `"${rec.beneficiary_name}" saved successfully.`, 'success');
                } catch (err) {
                    Swal.fire('Registration Failed', err.message, 'error');
                }
            },

            openSessionModal(prefillBeneficiary = null) {
                this.lookup = { eir_id:'', foolhumaa_form_number:'', beneficiary_national_id:'', status:'idle', result:null };
                this.session.beneficiary = null;
                this.visitForm = this.blankVisitForm();
                if (prefillBeneficiary) {
                    this.session.beneficiary = prefillBeneficiary;
                    this.visitForm.currently_living = prefillBeneficiary.currently_living || '';
                }
                this.showSessionModal = true;
            },
            closeSessionModal() {
                this.showSessionModal = false;
                this.cancelSession();
            },
            cancelSession() {
                this.session.beneficiary = null;
                this.lookup = { eir_id:'', foolhumaa_form_number:'', beneficiary_national_id:'', status:'idle', result:null };
                this.visitForm = this.blankVisitForm();
            },
            debouncedLookup() {
                clearTimeout(this._lookupTimer);
                this._lookupTimer = setTimeout(() => this.performLookup(), 250);
            },
            performLookup() {
                const e = (this.lookup.eir_id || '').trim();
                const f = (this.lookup.foolhumaa_form_number || '').trim();
                const n = (this.lookup.beneficiary_national_id || '').trim();
                if (!e && !f && !n) {
                    this.lookup.status = 'idle';
                    this.lookup.result = null;
                    return;
                }
                this.lookup.status = 'searching';
                const clauses = [], params = [];
                if (e) { clauses.push('eir_id = ?'); params.push(e); }
                if (f) { clauses.push('foolhumaa_form_number = ?'); params.push(f); }
                if (n) { clauses.push('beneficiary_national_id = ?'); params.push(n); }

                let row = null;
                try {
                    const stmt = this.db.prepare(
                        `SELECT * FROM vaccination_registry WHERE ${clauses.join(' OR ')} LIMIT 1;`
                    );
                    stmt.bind(params);
                    if (stmt.step()) row = stmt.getAsObject();
                    stmt.free();
                } catch (err) { console.error(err); }
                if (row) { this.lookup.result = row; this.lookup.status = 'found'; }
                else { this.lookup.result = null; this.lookup.status = 'notfound'; }
            },
            startSession() {
                if (!this.lookup.result) return;
                this.session.beneficiary = this.lookup.result;
                this.visitForm = this.blankVisitForm();
                this.visitForm.currently_living = this.lookup.result.currently_living || '';
            },
            goToRegisterFromSession() {
                const prefill = {
                    eir_id: this.lookup.eir_id || '',
                    foolhumaa_form_number: this.lookup.foolhumaa_form_number || '',
                    beneficiary_national_id: this.lookup.beneficiary_national_id || ''
                };
                this.closeSessionModal();
                this.openRegisterModal(prefill);
                Swal.fire({ title: 'Register New', text: 'Complete registration for this child.', icon: 'info', timer: 1500, showConfirmButton: false });
            },
            blankVisitForm() {
                const f = {
                    visit_date: new Date().toISOString().slice(0,10),
                    vaccine_centre: '',
                    currently_living: ''
                };
                for (let i = 1; i <= MAX_DOSES_PER_EVENT; i++) {
                    f[`vaccine_name${i}`] = '';
                    f[`vaccine_type${i}`] = '';
                }
                return f;
            },
            submitVisit() {
                if (!this.session.beneficiary) return;
                const b = this.session.beneficiary;
                const f = this.visitForm;
                try {
                    const evRec = { event_id: this.generateId(), dose_count: 0 };
                    evRec.visit_date = excelDateToISO(f.visit_date);
                    evRec.vaccine_centre = (f.vaccine_centre || '').trim() || null;
                    evRec.currently_living = (f.currently_living || '').trim() || (b.currently_living || null);
                    evRec.eir_id = b.eir_id || null;
                    evRec.foolhumaa_form_number = b.foolhumaa_form_number || null;
                    evRec.beneficiary_national_id = b.beneficiary_national_id || null;
                    evRec.beneficiary_name = b.beneficiary_name || null;
                    evRec.dob = excelDateToISO(b.dob) || null;
                    evRec.age_at_visit = calculateAgeBetween(evRec.dob, evRec.visit_date);
                    evRec.sex = b.sex || null;

                    let dc = 0;
                    for (let i = 1; i <= MAX_DOSES_PER_EVENT; i++) {
                        const vn = (f[`vaccine_name${i}`] || '').trim();
                        const vt = (f[`vaccine_type${i}`] || '').trim();
                        evRec[`vaccine_name${i}`] = vn || null;
                        evRec[`vaccine_type${i}`] = vt || null;
                        if (vn) dc++;
                    }
                    evRec.dose_count = dc;
                    if (dc === 0) {
                        Swal.fire('No doses', 'Please record at least one vaccine.', 'warning');
                        return;
                    }
                    const keys = Object.keys(evRec);
                    this.db.run(
                        `INSERT INTO vaccination_events (${keys.join(',')}) VALUES (${keys.map(() => '?').join(',')});`,
                        keys.map(k => evRec[k])
                    );
                    this.persist();
                    this.refreshAll();
                    this.closeSessionModal();
                    Swal.fire('Visit Saved', `${dc} dose(s) recorded for ${b.beneficiary_name}.`, 'success');
                } catch (err) {
                    Swal.fire('Save Failed', err.message, 'error');
                }
            },

            downloadRegistryTemplate() {
                const ws = XLSX.utils.aoa_to_sheet([REGISTRY_COLUMNS]);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Registry');
                XLSX.writeFile(wb, 'SHAH-EIR_Registry_Template.xlsx');
            },
            downloadEventsTemplate() {
                const ws = XLSX.utils.aoa_to_sheet([EVENT_COLUMNS]);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Events');
                XLSX.writeFile(wb, 'SHAH-EIR_Events_Template.xlsx');
            },

            importRegistry(event) {
                const file = event.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array', cellDates: true });
                        const sheet = wb.Sheets[wb.SheetNames[0]];
                        const rows = XLSX.utils.sheet_to_json(sheet, { defval: null, raw: true });
                        if (!rows.length) {
                            Swal.fire('Empty file', 'No data rows found.', 'warning');
                            event.target.value = '';
                            return;
                        }
                        let imported = 0, updated = 0, skipped = 0, reasons = [];
                        this.db.run("BEGIN TRANSACTION;");
                        for (const row of rows) {
                            if (!row.beneficiary_name || !row.eir_id) {
                                skipped++; reasons.push('Missing beneficiary_name or eir_id');
                                continue;
                            }
                            const rec = {};
                            for (const col of REGISTRY_COLUMNS) {
                                if (row[col] !== undefined && row[col] !== null && row[col] !== '') {
                                    rec[col] = typeof row[col] === 'string' ? row[col].trim() : row[col];
                                }
                            }

                            rec.dob = excelDateToISO(rec.dob);
                            if (rec.gestational_age_weeks) rec.gestational_age_weeks = parseInt(rec.gestational_age_weeks, 10) || null;
                            if (rec.birth_weight) rec.birth_weight = parseFloat(rec.birth_weight) || null;
                            if (rec.number_delivered) rec.number_delivered = parseInt(rec.number_delivered, 10) || null;

                            try {
                                const existing = this.queryAll(`SELECT id FROM vaccination_registry WHERE eir_id = ? LIMIT 1;`, [rec.eir_id]);
                                if (existing.length > 0) {
                                    rec.id = existing[0].id;
                                    const updateCols = Object.keys(rec).filter(k => k !== 'id' && k !== 'eir_id');
                                    const setClause = updateCols.map(k => `${k} = ?`).join(', ');
                                    const values = updateCols.map(k => rec[k]);
                                    values.push(rec.eir_id);
                                    this.db.run(`UPDATE vaccination_registry SET ${setClause} WHERE eir_id = ?;`, values);
                                    updated++;
                                } else {
                                    rec.id = this.generateId();
                                    const keys = Object.keys(rec);
                                    this.db.run(
                                        `INSERT INTO vaccination_registry (${keys.join(',')}) VALUES (${keys.map(() => '?').join(',')});`,
                                        keys.map(k => rec[k])
                                    );
                                    imported++;
                                }
                            } catch (err) {
                                skipped++;
                                if (reasons.length < 5) reasons.push(`${rec.eir_id || '?'}: ${err.message}`);
                            }
                        }
                        this.db.run("COMMIT;");
                        this.persist();
                        this.refreshAll();
                        event.target.value = '';
                        const html = `Imported (New): <b>${imported}</b><br>Updated: <b>${updated}</b><br>Skipped: <b>${skipped}</b>` +
                            (reasons.length ? `<br><br><span style="font-size:11px;color:#666;">${reasons.join('<br>')}</span>` : '');
                        Swal.fire({ title: 'Registry Import', html, icon: skipped === 0 ? 'success' : (imported === 0 && updated === 0 ? 'error' : 'warning') });
                    } catch (err) {
                        console.error(err);
                        Swal.fire('Import Failed', 'Could not parse file.', 'error');
                        event.target.value = '';
                    }
                };
                reader.readAsArrayBuffer(file);
            },

            importEvents(event) {
                const file = event.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array', cellDates: true });
                        const sheet = wb.Sheets[wb.SheetNames[0]];
                        const rows = XLSX.utils.sheet_to_json(sheet, { defval: null, raw: true });
                        if (!rows.length) {
                            Swal.fire('Empty file', 'No data rows found.', 'warning');
                            event.target.value = '';
                            return;
                        }
                        let eventsAdded = 0, clientsAdded = 0, skipped = 0, reasons = [];
                        this.db.run("BEGIN TRANSACTION;");
                        for (const row of rows) {
                            if (!row.eir_id || !row.beneficiary_name) {
                                skipped++; reasons.push('Missing eir_id or beneficiary_name');
                                continue;
                            }
                            const exists = this.queryAll(
                                `SELECT eir_id, dob FROM vaccination_registry WHERE eir_id = ? LIMIT 1;`,
                                [row.eir_id]
                            );
                            let clientDob = excelDateToISO(row.dob);
                            if (exists.length > 0) {
                                if (!clientDob && exists[0].dob) {
                                    clientDob = exists[0].dob;
                                }
                            } else {
                                const regRec = { id: this.generateId() };
                                for (const col of REGISTRY_FROM_EVENT) {
                                    if (row[col] !== undefined && row[col] !== null && row[col] !== '') {
                                        regRec[col] = typeof row[col] === 'string' ? row[col].trim() : row[col];
                                    }
                                }
                                regRec.dob = clientDob;

                                const k = Object.keys(regRec);
                                try {
                                    this.db.run(
                                        `INSERT INTO vaccination_registry (${k.join(',')}) VALUES (${k.map(() => '?').join(',')});`,
                                        k.map(x => regRec[x])
                                    );
                                    clientsAdded++;
                                } catch (err) {
                                    if (reasons.length < 5) reasons.push(`registry ${row.eir_id}: ${err.message}`);
                                }
                            }

                            const evRec = { event_id: this.generateId(), dose_count: 0 };
                            for (const col of EVENT_COLUMNS) {
                                if (col === 'age_at_visit') continue;
                                if (row[col] !== undefined && row[col] !== null && row[col] !== '') {
                                    evRec[col] = typeof row[col] === 'string' ? row[col].trim() : row[col];
                                } else {
                                    evRec[col] = null;
                                }
                            }

                            evRec.visit_date = excelDateToISO(evRec.visit_date);
                            evRec.dob        = clientDob;
                            evRec.age_at_visit = calculateAgeBetween(evRec.dob, evRec.visit_date);

                            let dc = 0;
                            for (let i = 1; i <= MAX_DOSES_PER_EVENT; i++) {
                                if (evRec[`vaccine_name${i}`]) dc++;
                            }
                            evRec.dose_count = dc;

                            const keys = Object.keys(evRec);
                            try {
                                if (row.event_id) {
                                    const checkEvent = this.queryAll(`SELECT event_id FROM vaccination_events WHERE event_id = ? LIMIT 1;`, [row.event_id]);
                                    if (checkEvent.length > 0) {
                                        evRec.event_id = row.event_id;
                                        const updateCols = keys.filter(k => k !== 'event_id');
                                        const setClause = updateCols.map(k => `${k} = ?`).join(', ');
                                        const values = updateCols.map(k => evRec[k]);
                                        values.push(evRec.event_id);
                                        this.db.run(`UPDATE vaccination_events SET ${setClause} WHERE event_id = ?;`, values);
                                        eventsAdded++;
                                    } else {
                                        evRec.event_id = row.event_id;
                                        this.db.run(
                                            `INSERT INTO vaccination_events (${keys.join(',')}) VALUES (${keys.map(() => '?').join(',')});`,
                                            keys.map(k => evRec[k])
                                        );
                                        eventsAdded++;
                                    }
                                } else {
                                    this.db.run(
                                        `INSERT INTO vaccination_events (${keys.join(',')}) VALUES (${keys.map(() => '?').join(',')});`,
                                        keys.map(k => evRec[k])
                                    );
                                    eventsAdded++;
                                }
                            } catch (err) {
                                skipped++;
                                if (reasons.length < 5) reasons.push(`event ${row.eir_id}: ${err.message}`);
                            }
                        }
                        this.db.run("COMMIT;");
                        this.persist();
                        this.refreshAll();
                        event.target.value = '';
                        const html =
                            `Events processed: <b>${eventsAdded}</b><br>` +
                            `New clients added: <b>${clientsAdded}</b><br>` +
                            `Rows skipped: <b>${skipped}</b>` +
                            (reasons.length ? `<br><br><span style="font-size:11px;color:#666;">${reasons.join('<br>')}</span>` : '');
                        Swal.fire({ title: 'Events Import', html, icon: skipped === 0 ? 'success' : (eventsAdded === 0 ? 'error' : 'warning') });
                    } catch (err) {
                        console.error(err);
                        Swal.fire('Import Failed', 'Could not parse file.', 'error');
                        event.target.value = '';
                    }
                };
                reader.readAsArrayBuffer(file);
            },

            get distinctLivingValues() {
                const set = new Set();
                for (const r of this.registry) {

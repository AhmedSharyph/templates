 * SHAH-EIR &bull; Database & Cloud Synchronization Module (Module 2)
 * ============================================================================
 * Manages in-memory SQLite WASM initialization, high-speed binary persistence,
 * and background Google Sheets synchronization.
 */
const DatabaseModule = {
    async initDatabase(appContext) {
        appContext.fetchClientIp();
        try {
            // Instant load from memory cache if available
            if (window.sharedShahDb) {
                appContext.db = window.sharedShahDb;
                appContext.visitForm = appContext.blankVisitForm();
                appContext.refreshAll();
                appContext.dbStatus = `DB ready (Cached) · ${appContext.registry.length} registry · ${appContext.events.length} events`;
                await appContext.hydrateFromCloud();
                return;
            }

            if (!window.SQL_WASM_LOADED) {
                window.SQL_WASM_LOADED = await initSqlJs({
                    locateFile: f => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${f}`
                });
            }
            const SQL = window.SQL_WASM_LOADED;

            // Load directly from high-speed Base64 binary storage (bypasses JSON parse lag entirely)
            const savedBin = localStorage.getItem('shah_eir_db_bin');
            let loaded = false;
            if (savedBin) {
                try {
                    const binaryString = atob(savedBin);
                    const len = binaryString.length;
                    const bytes = new Uint8Array(len);
                    for (let i = 0; i < len; i++) {
                        bytes[i] = binaryString.charCodeAt(i);
                    }
                    appContext.db = new SQL.Database(bytes);
                    loaded = true;
                } catch (e) { console.warn('Corrupt Binary DB, starting fresh:', e); }
            }
            if (!loaded) appContext.db = new SQL.Database();

            this.createTables(appContext);
            appContext.visitForm = appContext.blankVisitForm();
            appContext.refreshAll();

            window.sharedShahDb = appContext.db;
            await appContext.hydrateFromCloud();
        } catch (err) {
            console.error(err);
            appContext.dbStatus = 'DB init error: ' + err.message;
        }
    },

    createTables(ctx) {
        ctx.db.run(`
            CREATE TABLE IF NOT EXISTS vaccination_registry (
                id TEXT PRIMARY KEY,
                currently_living TEXT, eir_id TEXT UNIQUE, beneficiary_name TEXT NOT NULL,
                foolhumaa_form_number TEXT, beneficiary_national_id TEXT,
